{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "distribution",
  "position": {
    "x": 650,
    "y": 250,
    "z": 0,
    "height": 420,
    "width": 600,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "donutChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "orders"
                    }
                  },
                  "Property": "status"
                }
              },
              "queryRef": "orders.status",
              "nativeQueryRef": "status"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "orders"
                    }
                  },
                  "Property": "Total Orders"
                }
              },
              "queryRef": "orders.Total Orders",
              "nativeQueryRef": "Total Orders"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Order status'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
