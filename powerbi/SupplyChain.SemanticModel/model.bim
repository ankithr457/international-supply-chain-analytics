{
  "name": "SupplyChain",
  "compatibilityLevel": 1550,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "orders",
        "columns": [
          {
            "name": "order_id",
            "dataType": "string",
            "sourceColumn": "order_id",
            "summarizeBy": "none"
          },
          {
            "name": "warehouse",
            "dataType": "string",
            "sourceColumn": "warehouse",
            "summarizeBy": "none"
          },
          {
            "name": "ordered_units",
            "dataType": "int64",
            "sourceColumn": "ordered_units",
            "summarizeBy": "none"
          },
          {
            "name": "available_units",
            "dataType": "int64",
            "sourceColumn": "available_units",
            "summarizeBy": "none"
          },
          {
            "name": "blocked",
            "dataType": "boolean",
            "sourceColumn": "blocked",
            "summarizeBy": "none"
          },
          {
            "name": "delivery_delay_days",
            "dataType": "int64",
            "sourceColumn": "delivery_delay_days",
            "summarizeBy": "none"
          },
          {
            "name": "fulfilled_units",
            "dataType": "int64",
            "sourceColumn": "fulfilled_units",
            "summarizeBy": "none"
          },
          {
            "name": "shortage_units",
            "dataType": "int64",
            "sourceColumn": "shortage_units",
            "summarizeBy": "none"
          },
          {
            "name": "on_time_in_full",
            "dataType": "boolean",
            "sourceColumn": "on_time_in_full",
            "summarizeBy": "none"
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "orders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"order_id\", type text}, {\"warehouse\", type text}, {\"ordered_units\", Int64.Type}, {\"available_units\", Int64.Type}, {\"blocked\", type logical}, {\"delivery_delay_days\", Int64.Type}, {\"fulfilled_units\", Int64.Type}, {\"shortage_units\", Int64.Type}, {\"on_time_in_full\", type logical}, {\"status\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Orders",
            "expression": "COUNTROWS(orders)",
            "formatString": "#,0"
          },
          {
            "name": "Blocked Orders",
            "expression": "CALCULATE(COUNTROWS(orders), orders[blocked] = TRUE())",
            "formatString": "#,0"
          },
          {
            "name": "Unit Fill Rate",
            "expression": "DIVIDE(SUM(orders[fulfilled_units]), CALCULATE(SUM(orders[ordered_units]), orders[blocked] = FALSE()), 0)",
            "formatString": "0.00%"
          },
          {
            "name": "OTIF Rate",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(orders), orders[on_time_in_full] = TRUE()), COUNTROWS(orders), 0)",
            "formatString": "0.00%"
          },
          {
            "name": "Shortage Units",
            "expression": "SUM(orders[shortage_units])",
            "formatString": "#,0"
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"orders\"]"
      }
    ]
  }
}
