// Measures used by the embedded semantic model.

Total Orders = COUNTROWS(orders)

Blocked Orders = CALCULATE(COUNTROWS(orders), orders[blocked] = TRUE())

Unit Fill Rate = DIVIDE(SUM(orders[fulfilled_units]), CALCULATE(SUM(orders[ordered_units]), orders[blocked] = FALSE()), 0)

OTIF Rate = DIVIDE(CALCULATE(COUNTROWS(orders), orders[on_time_in_full] = TRUE()), COUNTROWS(orders), 0)

Shortage Units = SUM(orders[shortage_units])

